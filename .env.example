# Learning Loop — environment template. Placeholders only; never commit real values.
# Which variables go where is documented in docs/SECURITY.md and docs/DEPLOYMENT.md.

# ---- PUBLIC (safe to bundle into the mobile app / browser) ----
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- SERVER-ONLY (Edge Functions / CI / local scripts). NEVER prefix with EXPO_PUBLIC_ or NEXT_PUBLIC_ ----
# Provided automatically inside Supabase Edge Functions; set manually only for local scripts.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Optional but recommended (audit H6): URL of a dedicated LOGIN role that is only a member of app_server/app_jobs.
# Create it out-of-band (password never in a migration); falls back to SUPABASE_DB_URL + SET LOCAL ROLE.
APP_DB_URL=
# Shared secret for the scheduled `jobs` Edge Function (>= 24 random chars). Server-side only.
JOBS_SECRET=
